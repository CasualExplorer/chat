<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NetworkMonitor: whether the device is online. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Cloud backup is off, and the keys and settings are excluded from device
         transfer: the API keys are encrypted with a key that stays in this
         device's keystore, so a copy couldn't be read anyway. Conversations
         (chat.db) do move to a new phone in a device transfer. -->
    <application
        android:name=".ChatApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chat">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Chat.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
