<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window, light or dark
         by the system, until it does. -->
    <style name="Theme.Chat" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The launch screen, shown until the settings have loaded, as Now in
         Android does it. The icon is the launcher's, on its own background. -->
    <style name="Theme.Chat.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Chat</item>
    </style>
</resources>
